{
  "$description": "Tokens du projet, format DTCG 2025.10. Squelette : /bootstrap-project remplace ces valeurs par celles de DESIGN.md. design/tokens.css se génère depuis ce fichier (npm run tokens, dans e2e/).",
  "color": {
    "$type": "color",
    "fond": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
    "texte": { "$value": { "colorSpace": "srgb", "components": [0.11, 0.11, 0.12], "hex": "#1c1c1f" } },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.12, 0.35, 0.8], "hex": "#1f59cc" } },
    "lien": { "$value": "{color.accent}" }
  },
  "espace": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 16, "unit": "px" } },
    "4": { "$value": { "value": 32, "unit": "px" } }
  },
  "police": {
    "$type": "fontFamily",
    "texte": { "$value": ["system-ui", "sans-serif"] }
  }
}
